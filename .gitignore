# Volunteer web URL shortcuts — contain auth token, never commit.
volunteer-kiosk.webloc
volunteer-kiosk.url

# Python test venv (auto-created by run-tests.sh on first run).
tests/kiosk-web-venv/

# Local scratch: kiosk home-dir tree dumps captured for debugging.
kiosk_home.txt

# Python bytecode and tool caches (regenerated by the interpreter / pytest).
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local Claude Code working directory.
.claude/

# Root CA fetched by `make web-ca` — regenerated, never committed.
display-pi-rootCA.crt

# Per-site provisioning scripts (see the setup guide, "Script it: one file per
# site"). They name private key paths and internal addressing, and this repo is
# public. dev/deploy.sh reads this file as an rsync filter, so ignoring them
# also keeps them off the Pi.
*_setup.sh
